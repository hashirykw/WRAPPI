{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "wrappii.vercel.app"
        }
      ],
      "destination": "https://wrappingartdesign.no/:path*",
      "permanent": true
    },
    {
      "source": "/((?:en/)?[^/]+\\.(?:css|js|glb|woff2|json|md|map))",
      "has": [
        {
          "type": "header",
          "key": "sec-fetch-dest",
          "value": "document"
        }
      ],
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/README.md",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/README",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/.gitignore",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/polering-og-keramisk-coating",
      "destination": "/polering",
      "permanent": true
    },
    {
      "source": "/design-din-bil",
      "destination": "/design",
      "permanent": true
    },
    {
      "source": "/en-ppf",
      "destination": "/en/ppf",
      "permanent": true
    },
    {
      "source": "/en-color-ppf",
      "destination": "/en/color-ppf",
      "permanent": true
    },
    {
      "source": "/en-car-wrapping",
