      "destination": "/en/polishing",
      "permanent": true
    },
    {
      "source": "/en-wrap-studio",
      "destination": "/en/design",
      "permanent": true
    },
    {
      "source": "/en-prices",
      "destination": "/en/prices",
      "permanent": true
    },
    {
      "source": "/en-about-us",
      "destination": "/en/about",
      "permanent": true
    },
    {
      "source": "/en-contact",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/en-carlise-ppf",
      "destination": "/en/carlise-ppf",
      "permanent": true
    },
    {
      "source": "/en-projects",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/en/polishing-and-ceramic-coating",
      "destination": "/en/polishing",
      "permanent": true
    },
    {
      "source": "/en/wrap-studio",
      "destination": "/en/design",
      "permanent": true
    },
    {
      "source": "/en/about-us",
      "destination": "/en/about",
      "permanent": true
    },
    {
      "source": "/en/projects",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/en/about",
      "permanent": true
    },
    {
      "source": "/car-wrapping",
      "destination": "/en/car-wrapping",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/en/contact",
      "permanent": true
    },
    {
      "source": "/prices",
      "destination": "/en/prices",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/en",
      "permanent": true
    },
    {
      "source": "/wrap-studio",
      "destination": "/en/design",
      "permanent": true
    },
    {
      "source": "/polishing-and-ceramic-coating",
      "destination": "/en/polishing",
